# ==========================================
# AI TREND RESEARCH - ENVIRONMENT VARIABLES
# ==========================================

# --- FRONTEND CLIENT-SAFE (EXPOSED TO BROWSER) ---
# Supabase project URL (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public API Key (Safe with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- SERVER-SIDE ONLY (NEVER EXPOSE TO FRONTEND BROWSER) ---
# Google Gemini API Key for AI Trend Analysis, Content Ideas, Keyword Expansion, and KDP
GEMINI_API_KEY=your-gemini-api-key

# Optional external Trending API Key (e.g. SerpApi or RapidAPI Google Trends)
# If not provided, GoogleTrendsProvider uses Google's public Daily Trends RSS feed.
TRENDING_API_KEY=

# Development Mode Flag: 'true' to allow MockProvider in testing, 'false' in production
DEVELOPMENT_MODE=false

# Cloud Run / Host URL (injected automatically in Google AI Studio)
APP_URL=

